{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "app-entry.ts",
    "constants.ts",
    "columns-core.ts",
    "dom.ts",
    "game.ts",
    "runtime-types.ts",
    "audio/**/*.ts",
    "graphics/**/*.ts",
    "highScores/**/*.ts",
    "hud/**/*.ts",
    "overlays/**/*.ts",
    "gameSession/**/*.ts",
    "input/**/*.ts"
  ]
}
